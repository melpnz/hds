   "source": {
    "originalSource": "{\n  name: 'Выбор специализаций',\n  render: args => ({\n    components: {\n      BaseButton,\n      CpVacancyImportGroupsModal\n    },\n    setup() {\n      const modalRef = ref<InstanceType<typeof CpVacancyImportGroupsModal> | null>(null);\n      const selectedGroups = ref<number[]>([]);\n      function openModal() {\n        modalRef.value?.open();\n      }\n      function handleImportGroups(groupsIds: number[]) {\n        selectedGroups.value = groupsIds;\n        modalRef.value?.close();\n      }\n      onMounted(openModal);\n      return {\n        args,\n        modalRef,\n        selectedGroups,\n        openModal,\n        handleImportGroups\n      };\n    },\n    template: `\n      <div class=\"min-h-[360px] bg-ui-gray-bg p-6\">\n        <BaseButton @click=\"openModal\">Открыть модалку</BaseButton>\n        <p v-if=\"selectedGroups.length\" class=\"mt-4 text-body-m text-ui-gray-2\">\n          Выбраны группы: {{ selectedGroups.join(', ') }}\n        </p>\n        <CpVacancyImportGroupsModal\n          ref=\"modalRef\"\n          :groups=\"args.groups\"\n          :unpublished-vacancies-link=\"args.unpublishedVacanciesLink\"\n          :loading=\"args.loading\"\n          @import-groups=\"handleImportGroups\"\n        />\n      </div>\n    `\n  })\n}"
   }
  },
