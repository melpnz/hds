   "source": {
    "originalSource": "{\n  name: 'Мои файлы (без уведомления)',\n  args: {\n    attachments: [mockUploadedImageFile, mockUploadedDocxFile],\n    daysBeforeRemovalAttachments: 14,\n    didAttachmentsDelete: false,\n    isMine: true\n  },\n  render: () => ({\n    components: {\n      MessageAttachements\n    },\n    setup() {\n      // showChatFilesNotice: true + isLastMessageWithAttachments: true, но isMine: true —\n      // уведомление не показывается\n      provide(INJECTION_SYMBOLS.notices.showChatFilesNotice, ref(true));\n      provide(INJECTION_SYMBOLS.notices.hideChatFilesNotice, async () => {});\n      return {\n        attachments: [mockUploadedImageFile, mockUploadedDocxFile],\n        daysBeforeRemovalAttachments: 14,\n        didAttachmentsDelete: false,\n        isMine: true,\n        isLastMessageWithAttachments: true\n      };\n    },\n    template: `\n      <MessageAttachements\n        :attachments=\"attachments\"\n        :days-before-removal-attachments=\"daysBeforeRemovalAttachments\"\n        :did-attachments-delete=\"didAttachmentsDelete\"\n        :is-mine=\"isMine\"\n        :is-last-message-with-attachments=\"isLastMessageWithAttachments\"\n      />\n    `\n  })\n}"
   }
