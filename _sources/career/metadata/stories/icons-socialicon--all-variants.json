   "source": {
    "originalSource": "{\n  name: 'Все возможные варианты',\n  render: args => ({\n    components: {\n      SocialIcon\n    },\n    setup() {\n      return {\n        args,\n        variants: meta.argTypes?.icon?.options\n      };\n    },\n    mounted() {\n      const style = document.createElement('style');\n      style.textContent = `\n        .social-icon-instagram {\n          background: radial-gradient(\n            circle 19.26px at 6.59570325% 96.961876%,\n            rgb(255 214 0) 0%,\n            rgb(255 105 48 / 100%) 34.4%,\n            rgb(254 59 54 / 88%) 58.4%,\n            rgb(254 59 54 / 63%) 67%,\n            rgb(237 0 192 / 70%) 80%,\n            rgb(112 23 255 / 0%) 108%\n          ),\n          radial-gradient(\n            circle at 119.18119812011719% 143.7845001220703%,\n            #ff1b90 24.4%,\n            #f80261 43.7%,\n            #ed00c0 68.8%,\n            #c500e9 77.7%,\n            #5014F5 89.3%\n          );\n        }\n      `;\n      document.head.appendChild(style);\n    },\n    template: `\n      <div class=\"flex flex-wrap gap-4\">\n        <div v-for=\"variant in variants\" :key=\"variant\" class=\"flex flex-col items-center\">\n          <SocialIcon :class=\"'social-icon-' + variant\" v-bind=\"{ ...args, icon: variant }\" />\n          <div class=\"mt-2\">{{ variant }}</div>\n        </div>\n      </div>\n    `\n  })\n}"
   }
