   "source": {
    "originalSource": "{\n  name: 'Можно передать кастомный тогл в слот',\n  args: {\n    alignment: 'right'\n  },\n  render: args => ({\n    components: {\n      ContextMenu,\n      ContextMenuItem,\n      BaseButton,\n      SpriteIcon\n    },\n    setup() {\n      return {\n        args,\n        items\n      };\n    },\n    template: `\n          <div class=\"flex h-40 w-full items-center justify-center\">\n            <ContextMenu class=\"w-6\" v-bind=\"args\">\n              <template #toggle=\"{ toggle }\">\n                <BaseButton\n                  appearance=\"menu\"\n                  size=\"m\"\n                  class=\"gap-2\"\n                  @click=\"toggle(true)\"\n                >\n                  <template #before>\n                    <SpriteIcon icon=\"plus\" size=\"24\" />\n                  </template>\n                  Add item\n                </BaseButton>\n              </template>\n              <ContextMenuItem\n                v-for=\"item in items\"\n                :key=\"item.value\"\n                :value=\"item.value\"\n              >\n                {{ item.title }}\n              </ContextMenuItem>\n            </ContextMenu>\n          </div>\n    `\n  }),\n  argTypes: {\n    alignment: {\n      control: 'radio',\n      options: ['top-left', 'right']\n    }\n  }\n}"
   }
