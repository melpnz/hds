    "originalSource": "{\n  name: 'Обычное использование MultiSelect',\n  render: args => ({\n    components: {\n      MultiSelect\n    },\n    setup() {\n      const model = ref<number[]>([]);\n      const action = makeMockAction(SKILLS_OPTIONS);\n      return {\n        args,\n        model,\n        action\n      };\n    },\n    template: `\n\n    <MultiSelect\n      v-model=\"model\"\n      default-label=\"Все навыки\"\n      search-placeholder=\"Поиск по навыкам\"\n      :action=\"action\"\n      no-results-message=\"Такой навык не найден\"\n      cache-key=\"filter-skills\"\n    />\n`\n  }),\n  argTypes: {}\n}"
   }
