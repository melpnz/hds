    "originalSource": "{\n  argTypes: {\n    hasSalary: {\n      control: 'boolean',\n      name: 'Зарплата'\n    },\n    hasSkills: {\n      control: 'boolean',\n      name: 'Скиллы'\n    },\n    hasDivisions: {\n      control: 'boolean',\n      name: 'Специализация'\n    },\n    hasQualification: {\n      control: 'boolean',\n      name: 'Квалификация'\n    },\n    hasRemoteWork: {\n      control: 'boolean',\n      name: 'Удалёнка'\n    },\n    hasLocations: {\n      control: 'boolean',\n      name: 'Локации'\n    },\n    hasRating: {\n      control: 'boolean',\n      name: 'Рейтинг компании'\n    },\n    isAccredited: {\n      control: 'boolean',\n      name: 'Аккредитация компании'\n    },\n    isFavorited: {\n      control: 'boolean',\n      name: 'В избранном'\n    },\n    employment: {\n      control: 'radio',\n      name: 'Тип занятости',\n      options: ['full_time', 'part_time']\n    }\n  } as Story['argTypes'],\n  args: {\n    hasSalary: true,\n    hasSkills: true,\n    hasDivisions: true,\n    hasQualification: true,\n    hasRemoteWork: true,\n    hasLocations: true,\n    hasRating: true,\n    isAccredited: true,\n    isFavorited: false,\n    employment: 'full_time'\n  } as unknown as Story['args'],\n  render: (args: Record<string, unknown>) => ({\n    components: {\n      VacancyCardWithCompanyAndDate\n    },\n    setup() {\n      const vacancy = computed<VacancyWithCompanyAndDate>(() => ({\n        ...mockVacancyFull,\n        salary: args.hasSalary ? mockVacancyFull.salary : {\n          from: null,\n          to: null,\n          unit: null,\n          formatted: undefined\n        },\n        skills: args.hasSkills ? mockVacancyFull.skills : [],\n        divisions: args.hasDivisions ? mockVacancyFull.divisions : [],\n        salaryQualification: args.hasQualification ? mockVacancyFull.salaryQualification : null,\n        remoteWork: !!args.hasRemoteWork,\n        locations: args.hasLocations ? [{\n          title: 'Москва',\n          href: '/vacancies?location=moscow'\n        }] : null,\n        company: {\n          ...mockVacancyFull.company,\n          rating: args.hasRating ? mockVacancyFull.company.rating : null,\n          accredited: !!args.isAccredited\n        },\n        favorite: !!args.isFavorited,\n        employment: args.employment as VacancyWithCompanyAndDate['employment']\n      }));\n      return {\n        vacancy\n      };\n    },\n    template: '<VacancyCardWithCompanyAndDate :vacancy=\"vacancy\" />'\n  })\n}"
   },
