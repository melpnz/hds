   "source": {
    "originalSource": "{\n  name: 'Контекстное меню, которое адаптируется под экран',\n  args: {\n    placement: 'bottom-end',\n    icon: 'more'\n  },\n  render: args => ({\n    components: {\n      IsomorphicContextMenu,\n      MenuItem\n    },\n    setup() {\n      return {\n        args,\n        items\n      };\n    },\n    template: `\n          <ol>\n            <li>≥768px: показывает VDropdown</li>\n            <li><768px: превращается в нижнюю шторку через Teleport + ModalOverlay</li>\n          </ol>\n          <div class=\"flex w-full items-center justify-center\">\n            <IsomorphicContextMenu class=\"w-6\" v-bind=\"args\">\n              <MenuItem\n                v-for=\"item in items\"\n                :key=\"item.value\"\n                :value=\"item.value\"\n              >\n                {{ item.title }}\n              </MenuItem>\n            </IsomorphicContextMenu>\n          </div>\n    `\n  }),\n  argTypes: {\n    placement: {\n      control: 'radio',\n      options: ['bottom-end', 'top-start']\n    },\n    icon: {\n      control: 'radio',\n      options: ['more', 'additional-menu']\n    }\n  }\n}"
   }
  },
