   "source": {
    "originalSource": "{\n  name: 'Опции могут иметь поле image',\n  // @ts-expect-error  неважно для story\n  args: {\n    options: [{\n      title: 'Опция 1',\n      value: 'option1',\n      subtitle: 'Subtitle 1',\n      image: {\n        alt: 'Alt 1',\n        src: 'https://habrastorage.org/getpro/moikrug/uploads/company/100/007/328/7/logo/medium_bf1f932474521041a7dbe9cfbcc65796.png'\n      }\n    }, {\n      title: 'Опция 2',\n      value: 'option2',\n      image: {\n        alt: 'Alt 2',\n        src: 'https://habrastorage.org/getpro/moikrug/uploads/company/100/004/768/4/logo/medium_e182dee8b9cea6a89fa4bff81d9876ed.png'\n      }\n    }],\n    placeholder: 'Выберите опцию',\n    disabled: false\n  },\n  // @ts-expect-error  неважно для story\n  render: args => ({\n    components: {\n      BaseCustomSelect,\n      BaseCustomSelectOption\n    },\n    setup() {\n      const model = ref(null);\n      return {\n        args,\n        model\n      };\n    },\n    template: `\n  <BaseCustomSelect v-bind=\"args\" v-model=\"model\">\n    <template #option=\"{ option }\">\n      <BaseCustomSelectOption :option />\n    </template>\n  </BaseCustomSelect>\n`\n  }),\n  argTypes: {\n    placeholder: {\n      control: 'text',\n      description: 'Текст плейсхолдера, используемый если опция еще не была выбрана'\n    },\n    disabled: {\n      control: 'boolean',\n      description: 'Выключен ли контрол'\n    },\n    options: {\n      table: {\n        disable: true\n      }\n    },\n    modelValue: {\n      table: {\n        disable: true\n      }\n    }\n  }\n}"
   }
