   "source": {
    "originalSource": "{\n  name: 'Базовая модалка фильтров',\n  args: {\n    title: 'Фильтры',\n    activeCount: 3,\n    hasCloseButton: true,\n    disabled: false\n  },\n  render: args => ({\n    components: {\n      BaseButton,\n      BaseFilter,\n      BaseFilterModal\n    },\n    setup() {\n      const isOpen = ref(false);\n      const filters = ['Все', 'Онлайн', 'С сертификатом', 'Со скидкой'];\n      return {\n        args,\n        isOpen,\n        filters\n      };\n    },\n    template: `\n      <div class=\"min-h-[720px] bg-ui-black-50 p-8\">\n        <BaseButton size=\"m\" @click=\"isOpen = true\">Открыть фильтры</BaseButton>\n\n        <BaseFilterModal\n          v-if=\"isOpen\"\n          v-bind=\"args\"\n          @close=\"isOpen = false\"\n          @apply-filter=\"isOpen = false\"\n          @reset-filter=\"args.activeCount = 0\"\n        >\n          <div class=\"grid gap-6 p-3\">\n            <div class=\"text-body font-semibold\">Формат обучения</div>\n            <div class=\"flex flex-wrap gap-2\">\n              <BaseFilter\n                v-for=\"filter in filters\"\n                :key=\"filter\"\n                :active=\"filter === 'Онлайн'\"\n              >\n                {{ filter }}\n              </BaseFilter>\n            </div>\n            <div class=\"text-body font-semibold\">Описание</div>\n            <div class=\"text-small text-ui-black-500\">\n              Пример контента внутри базовой модалки фильтров для Storybook.\n            </div>\n          </div>\n        </BaseFilterModal>\n\n        <div id=\"modal-target\"></div>\n      </div>\n    `\n  }),\n  argTypes: {\n    title: {\n      control: 'text'\n    },\n    activeCount: {\n      control: 'number'\n    },\n    hasCloseButton: {\n      control: 'boolean'\n    },\n    disabled: {\n      control: 'boolean'\n    }\n  }\n}"
   }
