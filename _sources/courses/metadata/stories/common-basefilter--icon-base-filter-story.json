    "originalSource": "{\n  name: 'Фильтр с иконкой',\n  args: {\n    active: false,\n    filled: false,\n    appearance: 'default'\n  },\n  render: args => ({\n    components: {\n      BaseFilter,\n      SpriteIcon\n    },\n    setup() {\n      return {\n        args\n      };\n    },\n    template: `\n      <div class=\"p-8 w-max\">\n        <BaseFilter\n          v-bind=\"args\"\n        >\n          <SpriteIcon\n            aria-hidden=\"true\"\n            size=\"20\"\n            class=\"-ml-1 mr-1 h-6 w-6\"\n            :class=\"{\n              'text-ui-blue-500': args.active && !args.filled,\n              'text-ui-black-850': args.active || args.filled,\n            }\"\n            icon=\"sort\"\n          />\n          <span> Сортировка </span>\n        </BaseFilter>\n      </div>\n    `\n  }),\n  argTypes: {\n    active: {\n      control: 'boolean'\n    },\n    filled: {\n      control: 'boolean'\n    },\n    appearance: {\n      options: ['default', 'edu'],\n      control: {\n        type: 'radio'\n      }\n    }\n  }\n}"
