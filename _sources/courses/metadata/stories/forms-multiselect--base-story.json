   "source": {
    "originalSource": "{\n  name: 'Обычное использование MultiSelect',\n  render: args => ({\n    components: {\n      MultiSelect\n    },\n    setup() {\n      const actions = useCustomSelectActions();\n      const model = ref([]);\n      return {\n        args,\n        model,\n        actions\n      };\n    },\n    template: `\n    <MultiSelect\n      v-model=\"model\"\n      default-label=\"Все школы\"\n      search-placeholder=\"Поиск по школам\"\n      :action=\"actions.educationPlatforms\"\n      no-results-message=\"ничего не найдено\"\n      cache-key=\"filter-education-platforms\"\n    />\n`\n  }),\n  argTypes: {}\n}"
   }
