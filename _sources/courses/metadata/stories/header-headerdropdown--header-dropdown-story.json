   "source": {
    "originalSource": "{\n  args: {\n    sectionKey: 'services',\n    width: 220\n  },\n  render: args => ({\n    components: {\n      HeaderDropdown,\n      HeaderLogo\n    },\n    setup() {\n      return {\n        args,\n        sectionsMap\n      };\n    },\n    template: `\n      <div class=\"p-20 h-[500px] bg-main-gradient-first\">\n        <HeaderDropdown\n          :section=\"sectionsMap[args.sectionKey]\"\n          :width=\"args.width\"\n        >\n          <template #name>\n            <HeaderLogo v-if=\"args.sectionKey === 'services'\" />\n            <span v-if=\"args.sectionKey === 'services'\" class=\"ml-2 h-6 border-l border-l-ui-white-transparent-50\"></span>\n\n            <span v-if=\"args.sectionKey === 'courses'\" class=\"mr-0.5 text-small text-ui-white\">\n              {{ sectionsMap.courses.title }}\n            </span>\n          </template>\n\n          <template #title v-if=\"args.sectionKey === 'services'\">\n            <div class=\"text-small font-bold text-ui-black-850\">\n              {{ sectionsMap.services.title }}\n            </div>\n          </template>\n        </HeaderDropdown>\n      </div>\n    `\n  }),\n  argTypes: {\n    sectionKey: {\n      options: ['services', 'courses'],\n      control: {\n        type: 'radio'\n      },\n      name: 'section'\n    },\n    width: {\n      control: {\n        type: 'number',\n        min: 160,\n        max: 400,\n        step: 10\n      }\n    }\n  }\n}"
   }
  },
