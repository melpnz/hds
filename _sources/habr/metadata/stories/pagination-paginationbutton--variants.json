    "originalSource": "{\n  render: () => ({\n    components: {\n      StoryVariantGrid,\n      StoryVariantSection,\n      PaginationButton\n    },\n    setup() {\n      return {\n        directions,\n        routeFixture\n      };\n    },\n    template: `\n      <StoryVariantGrid>\n        <StoryVariantSection title=\"active\">\n          <PaginationButton\n            v-for=\"direction in directions\"\n            :id=\"'pagination-' + direction + '-page'\"\n            :key=\"direction\"\n            :direction=\"direction\"\n            :route=\"routeFixture\"\n          >\n            {{ direction === 'prev' ? 'Предыдущая' : 'Следующая' }}\n          </PaginationButton>\n        </StoryVariantSection>\n\n        <StoryVariantSection title=\"disabled\">\n          <PaginationButton\n            v-for=\"direction in directions\"\n            :id=\"'pagination-' + direction + '-page'\"\n            :key=\"direction\"\n            :direction=\"direction\"\n            :route=\"null\"\n          >\n            {{ direction === 'prev' ? 'Предыдущая' : 'Следующая' }}\n          </PaginationButton>\n        </StoryVariantSection>\n      </StoryVariantGrid>\n    `\n  })\n}"
   }
