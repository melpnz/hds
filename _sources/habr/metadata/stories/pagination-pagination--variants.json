   "source": {
    "originalSource": "{\n  render: (args: PaginationStoryArgs) => ({\n    components: {\n      StoryVariantGrid,\n      StoryVariantSection,\n      Pagination\n    },\n    setup() {\n      const globalStates = [{\n        currentPage: 1,\n        title: 'first page',\n        totalPages: 8\n      }, {\n        currentPage: 7,\n        title: 'middle with ellipses',\n        totalPages: 15\n      }, {\n        currentPage: 8,\n        title: 'last page',\n        totalPages: 8\n      }];\n      const localStates = [{\n        currentPage: 2,\n        title: 'query page',\n        totalPages: 5\n      }, {\n        currentPage: 4,\n        title: 'custom query p',\n        totalPages: 9,\n        localParamName: 'p'\n      }];\n      return {\n        args,\n        globalStates,\n        localStates\n      };\n    },\n    template: `\n      <StoryVariantGrid>\n        <StoryVariantSection v-for=\"state in globalStates\" :key=\"state.title\" :title=\"state.title\">\n          <div style=\"width: 760px; max-width: 100%;\">\n            <Pagination\n              :current-page=\"state.currentPage\"\n              :page-padding=\"args.pagePadding\"\n              :page-padding-mobile=\"args.pagePaddingMobile\"\n              :route-name=\"args.routeName\"\n              :total-pages=\"state.totalPages\"\n            />\n          </div>\n        </StoryVariantSection>\n\n        <StoryVariantSection v-for=\"state in localStates\" :key=\"state.title\" :title=\"state.title\">\n          <div style=\"width: 760px; max-width: 100%;\">\n            <Pagination\n              :current-page=\"state.currentPage\"\n              local\n              :local-param-name=\"state.localParamName || args.localParamName\"\n              :page-padding=\"args.pagePadding\"\n              :page-padding-mobile=\"args.pagePaddingMobile\"\n              route-name=\"INDEX\"\n              :total-pages=\"state.totalPages\"\n            />\n          </div>\n        </StoryVariantSection>\n      </StoryVariantGrid>\n    `\n  })\n}"
   }
  },
