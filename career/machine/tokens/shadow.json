{
  "id": "tokens-shadow",
  "kind": "token-group",
  "source": "archive:career/v1/machine/tokens.json#/shadow",
  "tokens": {
    "border-color": {
      "$type": "other",
      "$value": "{color.ui-gray-5}",
      "$extensions": {
        "guide": {
          "cssVar": "--shadow-border-color",
          "source": ":root career-web"
        }
      }
    },
    "border-color-hover": {
      "$type": "other",
      "$value": "{color.ui-gray-4}",
      "$extensions": {
        "guide": {
          "cssVar": "--shadow-border-color-hover",
          "source": ":root career-web"
        }
      }
    },
    "border-color-focus": {
      "$type": "other",
      "$value": "{color.ui-gray-4}",
      "$extensions": {
        "guide": {
          "cssVar": "--shadow-border-color-focus",
          "source": ":root career-web"
        }
      }
    },
    "border-color-disabled": {
      "$type": "other",
      "$value": "{color.ui-gray-shadow}",
      "$extensions": {
        "guide": {
          "cssVar": "--shadow-border-color-disabled",
          "source": ":root career-web"
        }
      }
    },
    "dropdown": {
      "$type": "other",
      "$value": "0 1px 20px 0 rgba(0,0,0,.2)",
      "$extensions": {
        "guide": {
          "cssVar": "--shadow-dropdown",
          "source": ":root career-web"
        }
      }
    }
  }
}
