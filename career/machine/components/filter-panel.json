gend><span class=\"checkbox\"><label class=\"checkbox-label\"><span class=\"checkbox-icon\"><input class=\"checkbox-input visually-hidden\" type=\"checkbox\" name=\"remote\" checked><span class=\"checkbox-button\"></span></span><span class=\"checkbox-text\">Можно удалённо</span></label></span><span class=\"checkbox\"><label class=\"checkbox-label\"><span class=\"checkbox-icon\"><input class=\"checkbox-input visually-hidden\" type=\"checkbox\" name=\"office\"><span class=\"checkbox-button\"></span></span><span class=\"checkbox-text\">В офисе</span></label></span></fieldset>\n  </div>\n  <div class=\"filter-panel__actions\"><button type=\"submit\" class=\"base-button inline-flex appearance-main size-l is-sizeable\"><span class=\"base-button__inner\"><span class=\"base-button__content\">Показать 1 272</span></span></button></div>\n</form>",
