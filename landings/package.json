{
  "name": "@hds/landings-guide",
  "version": "0.2.0",
  "private": true,
  "description": "Static HDS landing guide and file:// showcase",
  "scripts": {
    "build:dimension-tokens": "node ../tools/tokenize-dimensions.mjs landings --write",
    "validate:tokens": "node ../tools/tokenize-dimensions.mjs landings --check",
    "build:tokens": "node tools/build-tokens.mjs",
    "build:library": "node tools/build-library.mjs",
    "validate": "node validate.mjs && npm run validate:tokens",
    "capture:review": "node tools/capture-review.mjs",
    "test:file": "node tools/validate-file-viewer.mjs",
    "test": "npm run validate && npm run test:file"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "playwright": "1.63.0"
  }
}
