          <vector id="12276:465" name="Rectangle 3685" x="0" y="80" width="360" height="180" />
          <rounded-rectangle id="12276:466" name="2024-05-27_14-00-45_8514 1" x="47.609375" y="11.79803466796875" width="312.6967641835254" height="312.2934122945626" />
          <text id="12276:467" name="2006" x="-6" y="163" width="215" height="124" />
        </frame>
        <text id="12276:468" name="Зарегистрирован домен habrahabr.ru, а вскоре после появился сайт и первый пользователь." x="0" y="280" width="360" height="96" />
      </frame>
      <frame id="12276:469" name="Frame 123457542" x="838" y="0" width="360" height="474">
        <frame id="12276:470" name="2" x="0" y="50" width="360" height="260">
          <vector id="12276:471" name="Rectangle 3685" x="0" y="80" width="360" height="180" />
          <rounded-rectangle id="12276:472" name="c9efcfab4ddfe9327acd97ba337a2bcd 1" x="25" y="0" width="310" height="310" />
          <text id="12276:473" name="2006" x="-6" y="163" width="215" height="124" />
        </frame>
        <text id="12276:474" name="Первое время Хабр «трясло» в кармических войнах — одни неистово минусовали других, другие минусовали в ответ. Это помогло разработать ту систему кармы, которая есть сейчас." x="0" y="330" width="360" height="144" />
      </frame>
      <frame id="12276:475" name="Frame 123457544" x="0" y="504" width="360" height="400">
        <frame id="12276:476" name="3" x="0" y="0" width="360" height="260">
          <vector id="12276:477" name="Rectangle 3685" x="0" y="80" width="360" height="180" />
          <rounded-rectangle id="12276:478" name="2024-05-25_14-34-46_6341" x="21.29296875" y="10.4827880859375" width="343.4164715115203" height="309.4595879988883" />
          <text id="12276:479" name="2006" x="-6" y="163" width="215" height="124" />
        </frame>
        <text id="12276:480" name="О, работа! После долгого пути открыли раздел с вакансиями. Сегодня вы знаете его как Хабр Карьеру. Из этого же раздела вырос и Хабр Фриланс." x="0" y="280" width="360" height="120" />
      </frame>
      <frame id="12276:481" name="Frame 123457545" x="419" y="504" width="360" height="450">
        <frame id="12276:482" name="4" x="0" y="50" width="360" height="260">
          <vector id="12276:483" name="Rectangle 3685" x="0" y="80" width="360" height="180" />
          <rounded-rectangle id="12276:484" name="2024-05-25_14-23-11_9721" x="105" y="0" width="245" height="301.088134765625" />
          <text id="12276:485" name="2008" x="-6" y="163" width="215" height="124" />
        </frame>
        <text id="12276:486" name="Осенью был опубликован первый корпоративный пост. Сегодня IT-компании — это полноценные участники хабрасообщества." x="0" y="330" width="360" height="120" />
      </frame>
      <frame id="12276:487" name="Frame 123457546" x="838" y="504" width="360" height="426">
        <frame id="12276:488" name="5" x="0" y="50" width="360" height="260">
          <vector id="12276:489" name="Rectangle 3685" x="0" y="80" width="360" height="180" />
          <rounded-rectangle id="12276:490" name="2024-05-27_21-21-49_3054" x="343.7265625" y="-14.209014892578125" width="294.48852512471785" height="315.1807023588335" />
          <text id="12276:491" name="2010" x="-6" y="163" width="215" height="124" />
        </frame>
        <text id="12276:492" name="Запущен раздел вопросов и ответов, который со временем выделился в проект «Тостер» (сейчас — Хабр Q&amp;A)." x="0" y="330" width="360" height="96" />
      </frame>
      <frame id="12276:493" name="Frame 123457547" x="0" y="984" width="360" height="402">
        <frame id="12276:494" name="6" x="0" y="50" width="360" height="260">
          <vector id="12276:495" name="Rectangle 3685" x="0" y="80" width="360" height="180" />
          <rounded-rectangle id="12276:496" name="2024-05-25_13-31-03_9625" x="276.55078125" y="-45.710693359375" width="390.71016702726774" height="401.5380932989574" />
          <text id="12276:497" name="2011" x="-6" y="163" width="215" height="124" />
        </frame>
        <text id="12276:498" name="Открыли программу поощрения авторов (ППА) для тех, кто пишет самые крутые технотексты." x="0" y="330" width="360" height="72" />
      </frame>
      <frame id="12276:499" name="Frame 123457548" x="419" y="984" width="360" height="402">
        <frame id="12276:500" name="7" x="0" y="50" width="360" height="260">
          <vector id="12276:501" name="Rectangle 3685" x="0" y="80" width="360" height="180" />
          <rounded-rectangle id="12276:502" name="2024-05-25_13-35-22_5774 1" x="115" y="0" width="240" height="289.49554443359375" />
          <text id="12276:503" name="2014" x="-6" y="163" width="215" height="124" />
        </frame>
        <text id="12276:504" name="Провели масштабный редизайн. Во многом он определил тот Хабр, который вы видите сегодня." x="0" y="330" width="360" height="72" />
      </frame>
      <frame id="12276:505" name="Frame 123457549" x="838" y="984" width="360" height="376">
        <frame id="12276:506" name="8" x="0" y="0" width="360" height="260">
          <vector id="12276:507" name="Rectangle 3685" x="0" y="80" width="360" height="180" />
          <rounded-rectangle id="12276:508" name="2024-05-27_22-30-39_5341" x="100" y="0" width="260" height="314.2911376953125" />
          <text id="12276:509" name="2015" x="-6" y="163" width="215" height="124" />
        </frame>
        <text id="12276:510" name="Перезапустили «Мой Круг» и объединили его с нашим сервисом Brainstorage — сегодня это Хабр Карьера." x="0" y="280" width="360" height="96" />
      </frame>
      <frame id="12276:511" name="Frame 123457550" x="0" y="1416" width="360" height="376">
        <frame id="12276:512" name="9" x="0" y="0" width="360" height="260">
          <vector id="12276:513" name="Rectangle 3685" x="0" y="80" width="360" height="180" />
          <rounded-rectangle id="12276:514" name="2024-05-27_22-33-21_6386" x="175" y="0" width="185" height="269.0908508300781" />
          <text id="12276:515" name="2019" x="-6" y="163" width="215" height="124" />
        </frame>
        <text id="12276:516" name="Отправили Хабр в заморское плаванье, сегодня англоязычную версию читают и комментируют около 400К человек в месяц." x="0" y="280" width="360" height="96" />
      </frame>
      <frame id="12276:517" name="Frame 123457551" x="419" y="1416" width="360" height="402">
        <frame id="12276:518" name="10" x="0" y="50" width="360" height="260">
          <vector id="12276:519" name="Rectangle 3685" x="0" y="80" width="360" height="180" />
          <rounded-rectangle id="12276:520" name="2024-05-27_21-23-31_8815" x="355" y="0" width="245" height="300.8227844238281" />
          <text id="12276:521" name="2019" x="-6" y="163" width="215" height="124" />
        </frame>
        <text id="12276:522" name="Открыли раздел с новостями, чтобы вы были в курсе всего, что происходит на рынке." x="0" y="330" width="360" height="72" />
      </frame>
      <frame id="12276:523" name="Frame 123457552" x="838" y="1416" width="360" height="376">
        <frame id="12276:524" name="11" x="0" y="0" width="360" height="260">
          <vector id="12276:525" name="Rectangle 3685" x="0" y="80" width="360" height="180" />
          <rounded-rectangle id="12276:526" name="2024-05-27_14-08-55_7581 1" x="331.546875" y="-14.17535400390625" width="293.61784274874117" height="305.22875723326797" />
          <text id="12276:527" name="2019" x="-6" y="163" width="215" height="124" />
        </frame>
        <text id="12276:528" name="Количество зарегистрированных пользователей перевалило за миллион. Отпраздновали и двинулись дальше." x="0" y="280" width="360" height="96" />
      </frame>
      <frame id="12276:529" name="Frame 123457553" x="0" y="1848" width="360" height="352">
        <frame id="12276:530" name="12" x="0" y="0" width="360" height="260">
          <vector id="12276:531" name="Rectangle 3685" x="0" y="80" width="360" height="180" />
          <rounded-rectangle id="12276:532" name="2024-05-27_14-28-25_8497 1" x="80" y="0" width="270" height="270.9877624511719" />
          <text id="12276:533" name="2019" x="-6" y="163" width="215" height="124" />
        </frame>
        <text id="12276:534" name="Сделали шаг в сторону образования и открыли маркетплейс курсов в IT на базе Хабр Карьеры." x="0" y="280" width="360" height="72" />
      </frame>
      <frame id="12276:535" name="Frame 123457554" x="419" y="1848" width="360" height="450">
        <frame id="12276:536" name="13" x="0" y="50" width="360" height="260">
          <vector id="12276:537" name="Rectangle 3685" x="0" y="80" width="360" height="180" />
          <rounded-rectangle id="12276:538" name="2024-05-25_14-31-48_1004" x="337.96875" y="-3.0799560546875" width="242.38719254762327" height="284.62984648098427" />
          <text id="12276:539" name="2019" x="-6" y="163" width="215" height="124" />
        </frame>
        <text id="12276:540" name="Провели ребрендинг и объединили все продукты в одну семью, Тостер стал Хабр Q&amp;A, Мой Круг — Хабр Карьерой, Фрилансим — Хабр Фрилансом." x="0" y="330" width="360" height="120" />
      </frame>
      <frame id="12276:541" name="Frame 123457555" x="838" y="1848" width="360" height="450">
        <frame id="12276:542" name="14" x="0" y="50" width="360" height="260">
          <vector id="12276:543" name="Rectangle 3685" x="0" y="80" width="360" height="180" />
          <rounded-rectangle id="12276:544" name="2024-05-27_14-05-34_7912 1" x="311.77734375" y="-18.26531982421875" width="295.1602479992998" height="375.1831190188368" />
          <text id="12276:545" name="2020" x="-6" y="163" width="215" height="124" />
        </frame>
        <text id="12276:546" name="Ковидные изменения. Перешли на удаленку, вырастили HR-направление, пересмотрели видение компании, увеличили команду и стали сильнее." x="0" y="330" width="360" height="120" />
      </frame>
      <frame id="12276:547" name="Frame 123457556" x="0" y="2328" width="360" height="354">
        <frame id="12276:548" name="15" x="0" y="50" width="360" height="260">
          <vector id="12276:549" name="Rectangle 3685" x="0" y="80" width="360" height="180" />
          <rounded-rectangle id="12276:550" name="2024-05-25_14-25-54_6619" x="145" y="0" width="200" height="275.50872802734375" />
          <text id="12276:551" name="2021" x="-6" y="163" width="215" height="124" />
        </frame>
        <text id="12276:552" name="Запустили новый Хабр в бета-тест." x="0" y="330" width="360" height="24" />
      </frame>
      <frame id="12276:553" name="16" x="419" y="2328" width="360" height="378">
        <frame id="12276:554" name="Frame 123457525" x="0" y="50" width="360" height="260">
          <vector id="12276:555" name="Rectangle 3685" x="0" y="80" width="360" height="180" />
          <rounded-rectangle id="12276:556" name="2024-05-27_14-12-35_3616 1" x="366.46484375" y="11.5989990234375" width="322.9364565365486" height="301.3599858944217" />
          <text id="12276:557" name="2022" x="-6" y="163" width="215" height="124" />
        </frame>
        <text id="12276:558" name="Круто обновили маркетплейс курсов на Хабр Карьере." x="0" y="330" width="360" height="48" />
      </frame>
      <frame id="12276:559" name="Frame 123457559" x="838" y="2328" width="360" height="472">
        <frame id="12276:560" name="17" x="0" y="0" width="360" height="260">
          <vector id="12276:561" name="Rectangle 3685" x="0" y="80" width="360" height="180" />
          <rounded-rectangle id="12276:562" name="2024-05-25_14-27-34_4460" x="350" y="0" width="225" height="260" />
          <text id="12276:563" name="2023" x="-6" y="163" width="215" height="124" />
        </frame>
        <text id="12276:564" name="Придумали короткий и легкий формат контента — пост, сделали общую ленту и добавили календарь IT-ивентов. А еще запустили бета-версию нового продукта — карьерный трек для фронтендеров. На Хабр Карьере запустился сервис подбора менторов и экспертов в IT." x="0" y="280" width="360" height="192" />
      </frame>
      <frame id="12276:565" name="Frame 123457558" x="0" y="2830" width="360" height="328">
        <frame id="12276:566" name="Frame 123457525" x="0" y="0" width="360" height="260">
          <vector id="12276:567" name="Rectangle 3685" x="0" y="80" width="360" height="180" />
          <rounded-rectangle id="12276:568" name="2024-05-25_22-41-53_3793 1" x="115" y="0" width="240" height="334.6976318359375" />
          <text id="12276:569" name="2024" x="-6" y="163" width="215" height="124" />
        </frame>
        <text id="12276:570" name="Выкатили долгожданную темную тему на Хабре" x="0" y="280" width="360" height="48" />
      </frame>
      <frame id="12276:571" name="Frame 123457561" x="419" y="2830" width="360" height="328">
