    <frame id="9519:2949" name="Frame 123457147" x="218" y="224" width="579" height="230">
      <text id="9519:2950" name="На Хабр Карьере тысячи компаний, десятки тысяч специалистов и куча вакансий на любой вкус. Удалённых — в том числе. Тот, кто ищет работу, может написать в компанию первым, не дожидаясь нужной вакансии." x="24" y="138" width="555" height="92" />
      <boolean-operation id="9519:2951" name="Union" x="0" y="0" width="48" height="48" />
      <text id="9519:2956" name="&lt; место встречи &gt;" x="48" y="36" width="242" height="31" />
      <text id="9519:2957" name="айтишников и работодателей" x="48" y="67" width="396" height="31" />
    </frame>
    <frame id="9519:2958" name="Frame 123457145" x="218" y="514" width="560" height="213">
      <text id="9519:2959" name="Расскажите в нём о своем опыте, перечислите навыки, укажите образовательные курсы, которые вы прошли, и IT-сообщества, в которых участвуете. Оставляйте отзывы о компаниях и пишите рекомендации коллегам, а они напишут о вас." x="24" y="121" width="536" height="92" />
      <boolean-operation id="9519:2960" name="Union" x="0" y="0" width="48" height="48" />
      <text id="9519:2965" name="&lt; визитка в мире IT &gt;" x="48" y="36" width="282" height="31" />
      <text id="9519:2966" name="— профиль на Хабр Карьере &gt;" x="48" y="67" width="405" height="31" />
    </frame>
    <frame id="9519:2967" name="Frame 123457146" x="812" y="514" width="548" height="213">
      <text id="9519:2968" name="Среди IT-специалистов мы собираем данные о зарплатах и показываем их в анонимном виде. В нашем калькуляторе в любой момент можно посмотреть среднюю зарплату по специализациям, навыкам и городам." x="48" y="121" width="500" height="92" />
