# Зависимости
node_modules/

# Авторские материалы остаются локально, не входят в репозиторий для коллег
/.audits/
/.claude/
/_sources/
/design/
/temp/
/archive/
/showcase-template/
# Тяжёлое из журналов конвейера: сырые дампы, разовые скрипты, снимки.
# Сами отчёты -- capture.md, review-N.md, fix-N.md, accept.md -- версионируются:
# METHOD §2 требует, чтобы по .pipeline/ было видно, откуда взялось каждое
# утверждение. Прежнее правило /*/.pipeline/R*/ исключало папку шага целиком
# и вместе с дампами прятало все отчёты, включая приёмки.
/*/.pipeline/R*/raw-*
/*/.pipeline/R*/*.mjs
# Исключение: генераторы bulk-прохода Курсов версионируются. Витрина,
# спецификации и слои ui/ пересобираются ими, и без них повторить сборку из
# репозитория нельзя (решение владельца 11 сентября 2026). Разовые снимки
# shot*.mjs остаются локально.
!/courses/.pipeline/R2-bulk/*.mjs
/courses/.pipeline/R2-bulk/shot*.mjs
/*/.pipeline/R*/*.png
/*/.pipeline/*/raw-*.xml
/*/.pipeline/*/*.png
/*/.pipeline/capture-log.md
# Производные дампы bulk-проходов: извлечённая разметка и резолв правил
# по каждой записи. Пересобираются своими скриптами из evidence/, который
# в пакете есть, поэтому в git не нужны. В git остаются отчёты (*.md)
# и измерения, на которые ссылаются утверждения пакета.
/*/.pipeline/R*/extracted/
/*/.pipeline/R*/resolved/
/*/.pipeline/R*/storybook-only.json
/*/.pipeline/R*/results.json

# Артефакты прогонов Playwright
test-results/
playwright-report/
.playwright-mcp/

# Профиль браузера для локальных прогонов
.chrome-test/

# Временные снимки инструментов (.tmp-*.png и т. п.)
.tmp-*
*.tmp

# Разовые скриншоты проверок
career/icons-test.png

# Мусор ОС и редакторов
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.swp
*~

# Сырые рендеры аудита: 100 МБ PNG, восстанавливаются повторным прогоном
.audits/assets/**/*.png

# Локальные настройки и состояние инструментов — не публикуем
.claude/settings.local.json
.claude/scheduled_tasks.lock
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Локальное состояние авторизации браузерных тестов
playwright/.auth/
.auth/

# Кэши Python и сборок
__pycache__/
*.pyc
.pytest_cache/
.cache/

# Локальные логи менеджеров пакетов
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
