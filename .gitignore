# Зависимости
node_modules/

# Авторские материалы остаются локально, не входят в репозиторий для коллег
/.audits/
/.claude/
/_sources/
/design/
# Журналы и разовые скрипты сборки; inventory.json остаётся в Git
/*/.pipeline/R*/
/*/.pipeline/capture-log.md

# Артефакты прогонов Playwright
test-results/
playwright-report/
.playwright-mcp/

# Профиль браузера для локальных прогонов
.chrome-test/

# Временные снимки инструментов (.tmp-*.png и т. п.)
.tmp-*
*.tmp

# Разовые скриншоты проверок
career/icons-test.png

# Мусор ОС и редакторов
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.swp
*~

# Сырые рендеры аудита: 100 МБ PNG, восстанавливаются повторным прогоном
.audits/assets/**/*.png

# Локальные настройки и состояние инструментов — не публикуем
.claude/settings.local.json
.claude/scheduled_tasks.lock
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Локальное состояние авторизации браузерных тестов
playwright/.auth/
.auth/

# Кэши Python и сборок
__pycache__/
*.pyc
.pytest_cache/
.cache/

# Локальные логи менеджеров пакетов
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
