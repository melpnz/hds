{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Хабр Курсы — machine-first showcase item",
  "$defs": {
    "compositionNode": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "id", "role", "providerComponentId", "exportName"],
          "properties": {
            "kind": { "const": "provider-component" },
            "id": { "type": "string" },
            "role": { "type": "string" },
            "providerComponentId": { "type": "string" },
            "exportName": { "type": "string" },
            "count": { "type": "integer", "minimum": 1 },
            "variant": { "type": "string" },
            "props": { "type": "object" },
            "children": { "type": "array", "items": { "$ref": "#/$defs/compositionNode" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "element", "role"],
          "properties": {
            "kind": { "const": "native" },
            "element": { "type": "string" },
            "role": { "type": "string" },
            "placement": { "type": "string" },
            "responsive": { "type": "string" },
            "children": { "type": "array", "items": { "$ref": "#/$defs/compositionNode" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "id", "role"],
          "properties": {
            "kind": { "const": "external-slot" },
            "id": { "type": "string" },
            "role": { "type": "string" },
            "renderedContent": { "type": "string" },
            "emptyHeightToken": { "type": "string", "pattern": "^--courses-" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "required": ["id", "title", "kind", "category", "maturity", "knowledge", "purpose", "implementation", "states", "examples", "evidence", "unknowns"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string" },
    "kind": { "enum": ["foundation", "component", "module", "pattern"] },
    "category": { "type": "string" },
    "maturity": {
      "type": "object",
      "required": ["spec", "markup"],
      "properties": {
        "spec": { "enum": ["complete", "partial", "missing"] },
        "markup": { "enum": ["available", "partial", "missing"] }
      },
      "additionalProperties": false
    },
    "knowledge": { "type": "object", "required": ["authority", "confidence", "scope"] },
    "purpose": { "type": "string" },
    "visual": { "type": "object", "minProperties": 1 },
    "implementation": { "type": "object", "required": ["markup", "styles"] },
    "states": { "type": "object", "required": ["ui", "feature", "domain"] },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "file", "preview"],
        "properties": {
          "presentation": {
            "type": "object",
            "required": ["layout"],
            "properties": {
              "layout": { "enum": ["fit-content", "constrained", "canvas", "context"] },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          },
          "preview": {
            "oneOf": [
              {
                "type": "object",
                "required": ["mode"],
                "properties": { "mode": { "const": "intrinsic" } },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["mode", "widths", "height"],
                "properties": {
                  "mode": { "const": "viewport" },
                  "widths": { "type": "array", "const": [320, 480, 768, 1024] },
                  "height": { "type": "integer", "minimum": 1 }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      }
    },
    "previewNotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "text"],
        "properties": {
          "type": { "enum": ["guidance", "assumption", "coverage-warning"] },
          "text": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "evidence": { "type": "array" },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "rules": { "type": "array", "items": { "type": "string" } },
    "variants": { "type": "array" },
    "variantMatrix": { "type": "object" },
    "layoutRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "context", "behavior", "implementation"],
        "properties": {
          "id": { "type": "string" },
          "context": { "type": "string" },
          "behavior": { "type": "string" },
          "implementation": { "type": "string" },
          "evidence": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "accessibility": { "type": "array", "items": { "type": "string" } },
    "responsive": { "type": "array" },
    "family": { "type": "string" },
    "areas": { "type": ["array", "null"] },
    "modules": { "type": "array" },
    "components": { "type": "array" },
    "providerComposition": {
      "type": "object",
      "required": ["schemaVersion", "provider", "ownership", "shell", "areas", "directComponentIds"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "provider": {
          "type": "object",
          "required": ["id", "version", "mapping"],
          "properties": {
            "id": { "type": "string" },
            "version": { "type": "string" },
            "mapping": { "type": "string" }
          },
          "additionalProperties": false
        },
        "ownership": {
          "type": "object",
          "required": ["pagePattern", "componentImplementation", "staticExample"],
          "properties": {
            "pagePattern": { "const": "guide" },
            "componentImplementation": { "const": "active-provider" },
            "staticExample": { "const": "evidence-and-github-fallback" }
          },
          "additionalProperties": false
        },
        "shell": {
          "type": "object",
          "required": ["header", "footer"],
          "properties": {
            "header": { "$ref": "#/$defs/compositionNode" },
            "footer": { "$ref": "#/$defs/compositionNode" }
          },
          "additionalProperties": false
        },
        "areas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "nodes"],
            "properties": {
              "id": { "type": "string" },
              "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/compositionNode" } }
            },
            "additionalProperties": false
          }
        },
        "directComponentIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    }
  }
}
