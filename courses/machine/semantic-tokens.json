{
  "schemaVersion": 1,
  "product": "courses",
  "purpose": "Нейтральные семантические токены гайда, не привязанные к имени или API активного implementation provider.",
  "sourcePolicy": "Значения синхронизируются с подтверждённым активным provider; production-палитра сохраняется отдельно в machine/tokens.json.",
  "tokens": {
    "color": {
      "green-chip-background": { "$type": "color", "$value": "#e8f8ec", "cssVariable": "--courses-color-green-chip-background" },
      "text-primary-alpha-80": { "$type": "color", "$value": "rgb(44 46 52 / 80%)", "cssVariable": "--courses-color-text-primary-alpha-80" },
      "overlay-soft": { "$type": "color", "$value": "rgb(44 46 52 / 15%)", "cssVariable": "--courses-color-overlay-soft" },
      "overlay-subtle": { "$type": "color", "$value": "rgb(44 46 52 / 8%)", "cssVariable": "--courses-color-overlay-subtle" },
      "placeholder-soft-start": { "$type": "color", "$value": "#edf3ff", "cssVariable": "--courses-color-placeholder-soft-start" },
      "placeholder-soft-end": { "$type": "color", "$value": "#a9c8ff", "cssVariable": "--courses-color-placeholder-soft-end" },
      "success-art-end": { "$type": "color", "$value": "#c9dcff", "cssVariable": "--courses-color-success-art-end" },
      "brand-hover": { "$type": "color", "$value": "#3b3d43", "cssVariable": "--courses-color-brand-hover" }
    },
    "shadow": {
      "control": { "$type": "shadow", "$value": "0 .25rem .1875rem rgb(0 0 0 / 5%), 0 .125rem .125rem rgb(0 0 0 / 5%)", "cssVariable": "--courses-shadow-control" },
      "floating": { "$type": "shadow", "$value": "0 .25rem .375rem -.0625rem rgb(0 0 0 / 5%), 0 .125rem .25rem -.125rem rgb(0 0 0 / 5%)", "cssVariable": "--courses-shadow-floating" },
      "sheet": { "$type": "shadow", "$value": "0 .5rem 1.5rem rgb(44 46 52 / 16%)", "cssVariable": "--courses-shadow-sheet" },
      "focus-ring": { "$type": "shadow", "$value": "0 0 0 .125rem {color.ui-white}, 0 0 0 .1875rem {color.ui-black-400}", "cssVariable": "--courses-shadow-focus-ring" }
    },
    "layout": {
      "content-max": { "$type": "dimension", "$value": "67.25rem", "cssVariable": "--courses-content-max" }
    },
    "duration": {
      "fast": { "$type": "duration", "$value": "150ms", "cssVariable": "--courses-duration-fast" },
      "normal": { "$type": "duration", "$value": "300ms", "cssVariable": "--courses-duration-normal" },
      "loader": { "$type": "duration", "$value": "800ms", "cssVariable": "--courses-duration-loader" },
      "loader-reduced": { "$type": "duration", "$value": "1600ms", "cssVariable": "--courses-duration-loader-reduced" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": "ease", "cssVariable": "--courses-easing-standard" }
    },
    "opacity": {
      "muted": { "$type": "number", "$value": 0.7, "cssVariable": "--courses-opacity-muted" },
      "60": { "$type": "number", "$value": 0.6, "cssVariable": "--courses-opacity-60" },
      "hover": { "$type": "number", "$value": 0.8, "cssVariable": "--courses-opacity-hover" },
      "disabled-image": { "$type": "number", "$value": 0.45, "cssVariable": "--courses-opacity-disabled-image" }
    },
    "font-family": {
      "sans": { "$type": "fontFamily", "$value": "Inter, sans-serif", "cssVariable": "--courses-font-family-sans" }
    },
    "z-index": {
      "dropdown": { "$type": "number", "$value": 30, "cssVariable": "--courses-z-dropdown" },
      "sticky": { "$type": "number", "$value": 30, "cssVariable": "--courses-z-sticky" },
      "tooltip": { "$type": "number", "$value": 50, "cssVariable": "--courses-z-tooltip" },
      "modal": { "$type": "number", "$value": 70, "cssVariable": "--courses-z-modal" },
      "mobile-menu": { "$type": "number", "$value": 80, "cssVariable": "--courses-z-mobile-menu" }
    }
  }
}
