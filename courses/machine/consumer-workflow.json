{
  "schemaVersion": 2,
  "guide": {
    "id": "courses",
    "version": "1.1"
  },
  "provider": {
    "id": "courses-nuxt-kit",
    "version": "1.3.1"
  },
  "distribution": {
    "mode": "copy",
    "archive": "courses-nuxt-kit-v1.3.1.zip",
    "checksum": "courses-nuxt-kit-v1.3.1.zip.sha256",
    "releaseTag": "courses-nuxt-kit-v1.3.1",
    "releaseUrl": "https://github.com/melpnz/hds/releases/tag/courses-nuxt-kit-v1.3.1",
    "archiveUrl": "https://github.com/melpnz/hds/releases/download/courses-nuxt-kit-v1.3.1/courses-nuxt-kit-v1.3.1.zip",
    "checksumUrl": "https://github.com/melpnz/hds/releases/download/courses-nuxt-kit-v1.3.1/courses-nuxt-kit-v1.3.1.zip.sha256",
    "checksumAlgorithm": "sha256",
    "copiedDirectory": "layers/courses",
    "networkPolicy": "no-runtime-build-or-dev-requests",
    "availability": "published"
  },
  "preflight": {
    "frameworkDetection": "Inspect the target repository; apply the provider installation only to a Nuxt project.",
    "localManifest": "layers/courses/courses-kit.manifest.json",
    "ifCompatibleLayerExists": "Use it without a network request.",
    "ifLayerIsMissing": "Download the pinned published archive and checksum, verify SHA-256, and install the complete layers/courses directory before implementing Courses UI in Nuxt.",
    "ifLayerIsModifiedOrIncompatible": "Do not overwrite it. Report the version or integrity conflict and request an explicit migration decision.",
    "ifGitHubIsUnavailable": "Report that the pinned kit cannot be downloaded. Do not recreate provider components from screenshots or static examples."
  },
  "installation": {
    "requiredWhen": "A Courses service-interface implementation is requested in a Nuxt project and layers/courses is absent.",
    "steps": [
      "download archiveUrl and checksumUrl",
      "verify the archive with checksumAlgorithm using the downloaded checksum file",
      "extract the archive and copy its complete layers/courses directory to the target project's layers/courses",
      "install dependencies and devDependencies",
      "merge nuxtConfig without removing unrelated project configuration",
      "read the copied manifest and verify it against machine/compatibility.json"
    ],
    "dependencies": [
      "@nuxt/ui",
      "@fontsource-variable/inter",
      "swiper"
    ],
    "devDependencies": [
      "@iconify-json/tabler"
    ],
    "nuxtConfig": {
      "extends": [
        "./layers/courses"
      ],
      "modules": [
        "@nuxt/ui"
      ],
      "ui": {
        "colorMode": false
      }
    }
  },
  "usage": {
    "componentLookup": "machine/providers/courses-nuxt-kit.json -> selected apiFile",
    "behaviorLookup": "machine/catalog.json -> selected record and linked rules",
    "preferPublicComponent": true,
    "allowApplicationComponents": true,
    "applicationComponentsLocation": "outside layers/courses",
    "newCompositionWorkflow": "docs/decisions/unknowns.md",
    "reusePlanRequired": true,
    "reusePlanChoices": [
      "public-provider-component",
      "application-wrapper-using-public-api",
      "new-domain-composition-with-disclosed-assumptions",
      "missing-api-request-to-kit-owner"
    ],
    "newCompositionIsProductionEvidence": false,
    "newServiceShell": {
      "status": "owner-decision",
      "decidedAt": "2026-10-05",
      "source": "docs/decisions/unknowns.md",
      "preserveCoursesSiteHeader": true,
      "preserveCoursesSiteFooter": true,
      "navigationWhenUnspecified": "offer-options-and-wait-for-user-choice-before-implementation",
      "automaticSecondNavigationRow": false,
      "ordinaryPageHeading": "h1-on-shared-white-page-background-with-simple-site-header",
      "hero": "situational-choice-from-task-confirmed-contract-or-user-decision",
      "automaticTintedInnerTitlePanel": false,
      "continuousGradientWhenHeroAdjoinsHeader": true,
      "missingShellApi": "separate-canonical-kit-change-request-not-local-replacement"
    },
    "navigationAndFilters": {
      "classifyBeforeChoosingComponent": ["section-navigation", "content-switch", "list-filter"],
      "uncoveredCase": "explain-purpose-offer-options-and-ask-user",
      "listFilterControl": "filter-chip",
      "tabsForListFiltering": false,
      "filterRuleAppliesAtAllWidths": true,
      "editorStatusFilter": {
        "status": "owner-decision",
        "scope": "repititor-editor-status-filter-all-widths",
        "preferredComposition": "filter-chip-triggered-dropdown",
        "desktopAndBreakpoint": "same-composition-at-all-widths",
        "universalTabsReplacement": false
      }
    },
    "compositionApproval": {
      "status": "owner-decision",
      "decidedAt": "2026-10-05",
      "analogPage": "reuse-existing-composition-and-contract",
      "newScenario": "propose-blocks-order-and-desktop-mobile-layout-before-implementation",
      "materialAlternatives": "show-with-recommendation-and-wait-for-user-choice",
      "afterApproval": "assemble-with-public-kit-components-no-duplicates",
      "mobileContent": "preserve-meaningful-blocks-and-actions",
      "contentRemoval": "only-by-confirmed-address-contract-or-explicit-user-approval"
    },
    "stateComposition": {
      "status": "owner-decision",
      "decidedAt": "2026-10-05",
      "scope": ["loading", "empty-result", "error", "success"],
      "visuals": "reuse-public-kit-components-and-states-no-new-visual-style",
      "confirmedCase": "use-existing-contract",
      "uncoveredPlacementOrBehavior": "propose-and-get-user-approval-before-implementation",
      "isNewProductionEvidence": false
    },
    "verification": {
      "stateMatrixRequired": true,
      "compareDesktopMobileContentInventory": true,
      "visualReviewRequired": true,
      "openOverlayAfterTransition": true,
      "checkKeyboardAndReloadWhenApplicable": true,
      "reportSkippedChecks": true,
      "buildOrNoOverflowAloneIsAcceptance": false
    }
  },
  "ownership": {
    "copiedLayer": "vendored-read-only",
    "canonicalKitChanges": "maintainer-only",
    "missingApi": "request-change-from-maintainer",
    "localFork": "unsupported"
  },
  "updates": {
    "automatic": false,
    "automaticCheck": true,
    "checkAtStartOfAgentTask": true,
    "checkOnlyOnExplicitRequest": false,
    "command": "node layers/courses/scripts/check-update.mjs --json",
    "mutatesFiles": false,
    "offerUpdateOnly": true,
    "requiresExplicitApprovalToReplace": true,
    "neverReplaceWhenIntegrityIsDirty": true
  }
}
