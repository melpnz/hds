# По умолчанию: в репозитории LF, в рабочей копии тоже LF
* text=auto eol=lf

# Снимки первоисточников хранятся байт-в-байт, без нормализации
_sources/** -text

# Бинарные файлы
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# TSV fixture columns may intentionally end with empty tab-separated fields.
skills/**/tests/fixtures/*.tsv whitespace=-blank-at-eol
